/* --- Sarvam AI Inspired Light Theme --- */

/* Base Window */
QMainWindow, #MainWindow {
    background-color: #FAFAFA; /* Off-white / Clean Base */
}

/* Global Font & Text */
QWidget {
    font-family: 'Inter', 'Segoe UI', 'Roboto', 'Nirmala UI', 'Mangal', sans-serif;
    color: #111827; /* Dark Slate Gray */
    font-size: 11px;
}

/* --- Splash Screen --- */
#SplashScreen {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 12px;
}
#SplashTitleNormal {
    font-size: 43px;
    font-weight: 800;
    color: #EA580C; /* Orange */
    letter-spacing: 0.5px;
}
#SplashTitleSamarkan {
    font-family: 'Samarkan', 'Nirmala UI', 'Mangal', sans-serif;
    font-size: 43px;
    font-weight: 800;
    color: #EA580C; /* Orange */
}
#SplashLoading {
    font-size: 11px;
    color: #6B7280;
    margin-top: 10px;
}

/* --- Homepage --- */
#Homepage {
    background-color: #FAFAFA;
}
#LabelHomeTitleNormal {
    font-size: 60px;
    font-weight: 900;
    color: #EA580C; /* Orange */
    letter-spacing: -0.5px;
}
#LabelHomeTitleSamarkan {
    font-family: 'Samarkan', 'Nirmala UI', 'Mangal', sans-serif;
    font-size: 60px;
    font-weight: 900;
    color: #EA580C; /* Orange */
}
#LabelHomeTagline {
    font-size: 18px;
    font-weight: 600;
    color: #000000; /* Solid Black */
    padding-bottom: 30px;
}
#HomeBtnSaffron, #HomeBtnGreen, #HomeBtnPurple, #HomeBtnNavy {
    font-size: 11px;
    font-weight: 700;
    padding: 10px 16px;
    min-width: 100px;
    min-height: 32px;
    border-radius: 8px;
    border: 1px solid transparent;
    color: #FFFFFF;
}

#HomeBtnSaffron { background-color: rgba(255, 153, 51, 0.65); }
#HomeBtnSaffron:hover { background-color: rgba(230, 138, 46, 0.85); border: 1px solid #CC7A29; }
#HomeBtnSaffron:pressed { background-color: rgba(204, 122, 41, 0.95); padding-top: 12px; padding-bottom: 8px; }

#HomeBtnGreen { background-color: rgba(19, 136, 8, 0.65); }
#HomeBtnGreen:hover { background-color: rgba(16, 122, 7, 0.85); border: 1px solid #0E6B06; }
#HomeBtnGreen:pressed { background-color: rgba(14, 107, 6, 0.95); padding-top: 12px; padding-bottom: 8px; }

#HomeBtnPurple { background-color: rgba(94, 27, 204, 0.65); color: #FFFFFF; border: 1px solid transparent; } /* Purple */
#HomeBtnPurple:hover { background-color: rgba(76, 20, 168, 0.85); border: 1px solid #3B0D85; }
#HomeBtnPurple:pressed { background-color: rgba(58, 15, 133, 0.95); padding-top: 12px; padding-bottom: 8px; }

#HomeBtnNavy { background-color: rgba(0, 0, 128, 0.65); min-width: 100px; min-height: 32px; padding: 6px 12px; font-size: 10px; }
#HomeBtnNavy:hover { background-color: rgba(0, 0, 102, 0.85); border: 1px solid #00004D; }
#HomeBtnNavy:pressed { background-color: rgba(0, 0, 77, 0.95); padding-top: 8px; padding-bottom: 4px; }
#ButtonDisabled {
    background-color: #F3F4F6;
    color: #9CA3AF;
    border: 1px solid #E5E7EB;
}

/* --- Training Page --- */
#TrainingPage { background-color: #FAFAFA; }
#TrainingTitle { font-size: 19px; font-weight: 800; color: #4F46E5; padding: 8px; }
#TrainingLog {
    background-color: #FFFFFF; 
    color: #111827;
    font-family: 'Consolas', 'Menlo', 'Courier New', monospace;
    font-size: 10px;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    padding: 10px;
}

/* --- Recognition Page --- */
#RecognitionPage { background-color: #FAFAFA; }
#RecognitionHeaderTitle { font-size: 23px; font-weight: 800; color: #111827; }
#videoLabel {
    background-color: #000000;
    border: 1px solid #E5E7EB;
    border-radius: 12px;
    color: #9CA3AF;
    font-size: 13px;
}
#predictionBanner {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
}
#predictionLabel { color: #EA580C; font-size: 13px; font-weight: 800; }
#confidenceLabel { color: #6B7280; font-size: 11px; font-weight: 600; }

/* Recognition Buttons */
#startRecognitionButton {
    background-color: #4F46E5; /* Indigo */
    color: white;
    border: none;
    border-radius: 8px;
    padding: 8px 18px;
    font-size: 12px;
    font-weight: 700;
}
#startRecognitionButton:hover { background-color: #4338CA; }
#startRecognitionButton:pressed { background-color: #3730A3; }

#stopRecognitionButton {
    background-color: #DC2626; /* Deep Red */
    color: white;
    border: none;
    border-radius: 8px;
    padding: 8px 18px;
    font-size: 12px;
    font-weight: 700;
}
#stopRecognitionButton:hover { background-color: #B91C1C; }
#stopRecognitionButton:disabled { background-color: #F3F4F6; color: #9CA3AF; border: 1px solid #E5E7EB;}

#statusIndicator { color: #6B7280; font-size: 13px; }
#statusText { color: #4B5563; font-size: 11px; font-weight: 600; }

/* --- Manage Data Page --- */
#ManageDataPage { background-color: #FAFAFA; }
#ManageDataHeaderTitle { font-size: 23px; font-weight: 800; color: #111827; }
#statsContainer {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    padding: 18px;
    margin: 10px 0;
}
#dataStatsLabel { color: #111827; font-size: 11px; line-height: 1.6; }
#SectionLabel { font-size: 13px; font-weight: 800; color: #4F46E5; margin-top: 10px; }
#manageActionsList {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    font-size: 11px;
    padding: 4px;
}
#manageActionsList::item {
    padding: 10px;
    border-bottom: 1px solid #F3F4F6;
    border-radius: 6px;
}
#manageActionsList::item:hover { background-color: #FFF7ED; } /* Light orange hover */
#manageActionsList::item:selected { background-color: #EA580C; color: #FFFFFF; font-weight: 700; }

#detailsContainer {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    padding: 18px;
    min-height: 80px;
}
#actionDetailsLabel { color: #4B5563; font-size: 11px; line-height: 1.6; }

/* Manage Data Buttons */
#viewVideosButton, #exportDataButton, #manageDataButton, #refreshActionsButton {
    background-color: #FFFFFF; 
    border: 1px solid #D1D5DB; 
    color: #111827;
    font-size: 11px; 
    padding: 6px 12px; 
    border-radius: 8px; 
    font-weight: 600;
}
#viewVideosButton:hover, #exportDataButton:hover, #manageDataButton:hover, #refreshActionsButton:hover { 
    background-color: #F9FAFB; 
    border-color: #4F46E5; 
}
#viewVideosButton:disabled { background-color: #F3F4F6; color: #9CA3AF; border-color: #E5E7EB;}

#deleteActionButton { background-color: #FEE2E2; color: #AC1C1C; border-radius: 8px; padding: 6px 12px; border: 1px solid transparent; font-weight: 600; font-size: 11px;}
#deleteActionButton:hover { background-color: #FECACA; }
#deleteActionButton:disabled { background-color: #F3F4F6; color: #9CA3AF; }

#restartAppButton {
    background-color: #FEF3C7; 
    color: #92400E;
    font-weight: 700;
    font-size: 11px;
    padding: 6px 12px;
    border-radius: 8px;
    border: 1px solid transparent;
}
#restartAppButton:hover { background-color: #FDE68A; }

/* Sidebar */
#Sidebar {
    background-color: #F1F5F9; /* Distinct shade for sidebar */
    border-right: 1px solid #E5E7EB;
}
#Sidebar QScrollArea {
    background-color: transparent;
    border: none;
}
#SidebarContent {
    background-color: transparent;
}
#Sidebar QLabel { 
    font-size: 12px; 
    font-weight: 800; 
    color: #111827;
}
#SidebarTitle {
    font-size: 10px;
    font-weight: 700;
    color: #9CA3AF;
    margin-top: 15px;
    margin-bottom: 4px;
    text-transform: uppercase;
    letter-spacing: 0.8px;
}

#SidebarToggleBtn {
    background-color: transparent;
    border: none;
    color: #4F46E5;
    font-size: 18px;
    padding: 0px;
    margin: 0px;
}
#SidebarToggleBtn:hover {
    background-color: #E5E7EB;
    border-radius: 8px;
}

/* Main Content Area */
#MainContent, #SetupWidget { background-color: #FAFAFA; }

/* Labels */
QLabel { color: #111827; }
#SetupLabel { font-size: 13px; font-weight: 700; color: #111827; }
#LabelHelper { color: #6B7280; font-size: 10px; margin-top: 2px; font-weight: 500;}
#LabelBigOverlay { font-size: 43px; font-weight: 900; color: #FFFFFF; }
#LabelRecording {
    font-size: 19px;
    font-weight: 900;
    color: #FFFFFF; 
    background-color: rgba(220, 38, 38, 0.95); /* Deep Red */
    padding: 8px 18px;
    border-radius: 8px;
    border: none;
}
#LabelCountdown { font-size: 63px; font-weight: 900; color: #F59E0B; }
#LabelProcessing { font-size: 34px; font-weight: 900; color: #4F46E5; }

/* Buttons General */
QPushButton {
    background-color: #FFFFFF;
    color: #111827;
    border: 1px solid #D1D5DB;
    padding: 6px 12px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 11px;
}
QPushButton:hover { background-color: #F9FAFB; border-color: #4F46E5; }
QPushButton:pressed { background-color: #F3F4F6; }
QPushButton:disabled { background-color: #F3F4F6; color: #9CA3AF; border-color: #E5E7EB; }

#ButtonStop { background-color: #FEE2E2; color: #AC1C1C; border-color: transparent; font-size: 11px; padding: 10px; font-weight: 700;}
#ButtonStop:hover { background-color: #FECACA; border-color: transparent; }
#ButtonGray { background-color: #FFFFFF; }
#ButtonGray:hover { background-color: #F3F4F6; }
#ButtonGreen { background-color: #4F46E5; color: white; border-color: transparent; font-size: 11px; padding: 10px;}
#ButtonGreen:hover { background-color: #4338CA; border-color: transparent; }

#ButtonTrain {
    background-color: #EA580C; /* Vibrant Orange */
    color: white;
    border-color: transparent;
    font-size: 11px;
    padding: 10px;
    font-weight: 700;
}
#ButtonTrain:hover { background-color: #C2410C; border-color: transparent; }
#ButtonTrain:disabled { background-color: #F3F4F6; color: #9CA3AF; border-color: #E5E7EB; }

/* Inputs */
QLineEdit, QSpinBox, QComboBox {
    background-color: #FFFFFF;
    color: #111827;
    border: 1px solid #D1D5DB;
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 11px;
    font-weight: 500;
}
QLineEdit:focus, QSpinBox:focus, QComboBox:focus {
    border: 2px solid #EA580C; /* Focus highlight is Sarvam Orange */
    background-color: #FFFFFF;
}

/* SpinBox: separate up/down buttons */
QSpinBox {
    padding-right: 25px; /* room for the arrow buttons */
}
QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 24px;
    background-color: transparent;
    border-left: 1px solid #D1D5DB;
    border-top-right-radius: 8px;
    margin-top: 1px; margin-right: 1px;
}
QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 24px;
    background-color: transparent;
    border-left: 1px solid #D1D5DB;
    border-bottom-right-radius: 8px;
    margin-bottom: 1px; margin-right: 1px;
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #F3F4F6;
}
QSpinBox::up-arrow { 
    width: 10px; height: 10px;
    image: url(icons/arrow_up.svg);
}
QSpinBox::down-arrow { 
    width: 10px; height: 10px;
    image: url(icons/arrow_down.svg);
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #D1D5DB;
    selection-background-color: #FFF7ED;
    selection-color: #EA580C;
    border-radius: 8px;
    outline: none;
    color: #111827;
    padding: 4px;
}
QComboBox QAbstractItemView::item {
    min-height: 40px;
    padding-left: 10px;
    padding-right: 10px;
}

/* List */
QListWidget {
    background-color: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 8px;
    padding: 6px;
}
QListWidget::item { 
    padding: 10px 12px; 
    border-radius: 6px;
    margin-bottom: 2px;
    font-weight: 500;
}
QListWidget::item:hover { background-color: #FFF7ED; color: #C2410C;}
QListWidget::item:selected { background-color: #EA580C; color: white; font-weight: 700;}

/* Progress Bar */
QProgressBar {
    border: 1px solid #E5E7EB;
    background-color: #F3F4F6;
    border-radius: 8px;
    height: 14px;
    text-align: center;
    color: transparent; 
}
QProgressBar::chunk {
    background-color: #EA580C; /* Orange Progress */
    border-radius: 6px;
}

/* Custom Scrollbar */
QScrollBar:vertical {
    border: none;
    background: #FAFAFA;
    width: 8px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: #D1D5DB;
    min-height: 20px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover { background: #9CA3AF; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { border: none; background: none; }
QScrollBar:horizontal {
    border: none;
    background: #FAFAFA;
    height: 8px;
    margin: 0px;
}
QScrollBar::handle:horizontal {
    background: #D1D5DB;
    min-width: 20px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal:hover { background: #9CA3AF; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { border: none; background: none; }

/* Adjustable Splitter */
QSplitter::handle {
    background-color: #E5E7EB;
    width: 2px;
}
QSplitter::handle:horizontal {
    width: 2px;
}
QSplitter::handle:hover {
    background-color: #EA580C;
}

/* Custom Top Menu Bar */
#TopMenuBar {
    background-color: rgba(209, 213, 219, 0.6); /* Gray 300 with 60% opacity */
    border-bottom: 1px solid rgba(209, 213, 219, 0.8);
}
#TopMenuTitle {
    color: #111827; /* Dark text */
    font-weight: 800;
    font-size: 11px;
    letter-spacing: 1px;
}
#TopMenuTitleBtn {
    background-color: transparent;
    color: #111827; /* Dark text */
    font-weight: 800;
    border: none;
    font-size: 12px;
    letter-spacing: 1px;
    padding: 8px 15px;
}
#TopMenuTitleBtn:hover {
    background-color: #D1D5DB; /* Darker hover */
    border-radius: 6px;
}
#MenuBarButton {
    background-color: transparent;
    color: #111827; /* Dark text */
    font-weight: 700;
    border: none;
    font-size: 11px;
    padding: 8px 15px;
}
#MenuBarButton:hover {
    background-color: #D1D5DB; /* Darker hover */
    border-radius: 6px;
}

/* Custom Title Bar Controls */
QPushButton#TitleBarControlBtn {
    background-color: transparent;
    border: none;
    font-family: "Segoe Fluent Icons", "Segoe MDL2 Assets", sans-serif;
    font-size: 11px;
    font-weight: normal;
    color: #111827; /* Dark Text */
    padding: 0px;
}
QPushButton#TitleBarControlBtn:hover {
    background-color: #E5E5E5;
}
QPushButton#TitleBarCloseBtn {
    background-color: transparent;
    border: none;
    font-family: "Segoe Fluent Icons", "Segoe MDL2 Assets", sans-serif;
    font-size: 11px;
    font-weight: normal;
    color: #111827; /* Dark Text */
    padding: 0px;
}
QPushButton#TitleBarCloseBtn:hover {
    background-color: #E81123;
    color: white;
}
/* ========== RECORDING SCREEN STATUS BAR (Light theme) ========== */
QWidget#CollectionStatusBar {
    background-color: rgba(241, 245, 249, 0.96);
    border-top: 2px solid #EA580C;
}

QLabel#CollectionStatusLabel {
    color: #1E293B;
    font-size: 11px;
    font-family: 'Roboto', 'Nirmala UI', 'Mangal', sans-serif;
    letter-spacing: 0.5px;
}

QPushButton#CollectionStartBtn {
    background-color: #16A34A;
    color: #FFFFFF;
    font-size: 11px;
    font-weight: bold;
    font-family: 'Roboto', 'Nirmala UI', 'Mangal', sans-serif;
    padding: 8px 18px;
    border-radius: 6px;
    border: none;
    letter-spacing: 0.5px;
}
QPushButton#CollectionStartBtn:hover  { background-color: #15803D; }
QPushButton#CollectionStartBtn:pressed { background-color: #166534; }
QPushButton#CollectionStartBtn:disabled {
    background-color: #CBD5E1;
    color: #94A3B8;
}

QPushButton#CollectionStopBtn {
    background-color: transparent;
    color: #DC2626;
    font-size: 11px;
    font-weight: bold;
    font-family: 'Roboto', 'Nirmala UI', 'Mangal', sans-serif;
    padding: 8px 16px;
    border-radius: 6px;
    border: 2px solid #DC2626;
    letter-spacing: 0.5px;
}
QPushButton#CollectionStopBtn:hover  { background-color: rgba(220,38,38,0.08); }
QPushButton#CollectionStopBtn:pressed { background-color: rgba(220,38,38,0.18); }
